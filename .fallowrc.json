{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "test/**",
    "types/**",
    "pkg/**",
    "dev/**",
    "docs/**",
    "scripts/**",
    "template/**",
    "**/*.css"
  ],
  "duplicates": {
    "mode": "semantic",
    "minTokens": 40,
    "minLines": 5
  }
}
