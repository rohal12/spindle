{
  "name": "@rohal12/spindle",
  "version": "0.2.2",
  "type": "module",
  "description": "A Preact-based story format for Twine 2.",
  "license": "Unlicense",
  "author": "Rohal12",
  "engines": {
    "node": ">=22.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rohal12/spindle.git"
  },
  "homepage": "https://rohal12.github.io/spindle/",
  "bugs": "https://github.com/rohal12/spindle/issues",
  "keywords": [
    "twine-story-format",
    "twine",
    "interactive-fiction",
    "story-format",
    "preact"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pkg/index.js"
    },
    "./tooling": {
      "types": "./types/tooling.d.ts",
      "import": "./dist/pkg/tooling.js"
    },
    "./headless": {
      "types": "./types/headless.d.ts",
      "import": "./dist/pkg/headless.js"
    }
  },
  "files": [
    "dist/pkg/index.js",
    "dist/pkg/format.js",
    "dist/pkg/tooling.js",
    "dist/pkg/headless.js",
    "dist/pkg/story-variables.js",
    "dist/pkg/macro-registry.json",
    "dist/pkg/macro-registry.js",
    "types",
    "src"
  ],
  "scripts": {
    "build": "vite build && bun run scripts/build-format.ts && bun run scripts/dump-macro-registry.ts",
    "compile": "bun run scripts/compile-story.ts",
    "preview": "bun run build && bun run compile",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplication": "bun scripts/duplication.ts jscpd && bun scripts/duplication.ts cpd && bun scripts/duplication.ts fallow",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "bun run build && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "devalue": "^6.0.2",
    "immer": "^11.1.21",
    "micromark": "^4.0.3",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "preact": "^11.0.1",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@preact/preset-vite": "^2.10.6",
    "@rohal12/twee-ts": "^1.18.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "fallow": "3.33.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.3",
    "jscpd": "5.4.1",
    "lint-staged": "^17.6.0",
    "peggy": "5.1.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  }
}
